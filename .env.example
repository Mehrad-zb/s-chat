# ---- S-Chat settings (copy to .env — install.sh does this for you) ----
APP_NAME=Connection

# Main domain (DNS A record -> this server's IP)
DOMAIN=chat.satingraphic.ca
# All domains Caddy should serve (comma separated). Add ir.chat.satingraphic.ca if you set up the Iran relay.
DOMAINS=chat.satingraphic.ca
ACME_EMAIL=mehrad.tr@gmail.com
PUBLIC_IP=

# ---- Email login codes (SMTP) ----
# HostPapa mail: SMTP_HOST=mail.satingraphic.ca SMTP_PORT=465
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 + an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Connection <noreply@satingraphic.ca>

# ---- SMS login codes (VoIP.ms — Canada/US numbers only) ----
# VoIP.ms portal: Main Menu > SOAP and REST/JSON API > enable API, set API password, and allow this server's IP
VOIPMS_USER=
VOIPMS_API_PASS=
VOIPMS_DID=9056959147

# ---- Calls (TURN) — install.sh generates the secret ----
TURN_SECRET=
TURN_URLS=turn:{host}:3478?transport=udp,turn:{host}:3478?transport=tcp,turns:{host}:5349?transport=tcp

# ---- Uploads ----
MAX_UPLOAD_MB=200

# ---- Android app (TWA) ----
ANDROID_PACKAGE=ca.satingraphic.schat
# SHA-256 fingerprint of the APK signing key (printed by the GitHub build). Hides the browser bar in the app.
ANDROID_CERT_SHA256=E2:D6:15:04:85:A8:C1:E5:77:04:A6:72:B2:99:3A:40:EE:6C:15:D2:C0:9A:FB:CA:33:A2:1D:43:46:A0:1B:63
APK_URL=https://github.com/Mehrad-zb/s-chat/releases/latest/download/S-Chat.apk

# Secret for the owner settings page https://DOMAIN/setup.html#<SETUP_TOKEN> (install.sh generates it)
SETUP_TOKEN=

# Only for local testing: shows login codes on screen instead of sending them
DEV_MODE=0
